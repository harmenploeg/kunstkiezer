{
  "name": "kunstkiezer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none --test-reporter=spec tests/*.test.ts",
    "build": "vite build --config apps/web/vite.config.ts && node scripts/package-inventory.mjs",
    "dev": "vite --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy:staging": "npm run check && wrangler deploy --config workers/api/wrangler.jsonc --env staging",
    "deploy:production": "npm run check && wrangler deploy --config workers/api/wrangler.jsonc --env production",
    "test:e2e": "npm run build && playwright test --reporter=list",
    "test:db": "node --test --test-isolation=none tests/database.test.ts",
    "inventory:imports": "node scripts/generate-museum-imports.mjs",
    "pretest": "node scripts/generate-museum-imports.mjs && node scripts/generate-discovery-imports.mjs",
    "inventory:discovery": "node scripts/generate-discovery-imports.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.0.0"
  }
}
